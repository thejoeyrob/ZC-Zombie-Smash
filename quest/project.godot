; Zombie Smash VR (Meta Quest, OpenXR). The game logic is a port of the phone game (see docs/QUEST-VR.md).
config_version=5

[application]
config/name="Fatty's Game Shack"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Mobile")
run/max_fps=0

[debug]

file_logging/enable_file_logging=true
file_logging/max_log_files=2

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/vsync/vsync_mode=0

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
anti_aliasing/screen_space_roughness_limiter/enabled=true
anti_aliasing/screen_space_roughness_limiter/amount=0.3
anti_aliasing/screen_space_roughness_limiter/limit=0.2
textures/default_filters/anisotropic_filtering_level=16
textures/default_filters/use_nearest_mipmap_filter=false
textures/lightmap/directional=true
textures/lightmap/filter_strength=0.1
environment/defaults/default_clear_color=Color(0.02, 0.01, 0.05, 1)
global_illumination/voxel_gi/quality=1
global_illumination/sdfgi/cascade_count=2
global_illumination/sdfgi/min_cell_size=0.2
global_illumination/sdfgi/use_occlusion=false
lod_bias=1.5
max_renderable_elements=16384

[xr]
openxr/enabled=true
openxr/reference_space=2
openxr/foveation_level=1
openxr/foveation_dynamic=true
openxr/extensions/hand_tracking=true
shaders/enabled=true

[audio]

driver/enable_input=true
