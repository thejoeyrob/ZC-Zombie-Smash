; Zombie Smash VR (Meta Quest, OpenXR). The game logic is a port of the phone game (see docs/QUEST-VR.md).
config_version=5

[application]
config/name="Zombie Smash VR"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Mobile")
run/max_fps=0

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/vsync/vsync_mode=0

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.02, 0.01, 0.05, 1)

[xr]
openxr/enabled=true
openxr/reference_space=2
openxr/foveation_level=2
openxr/foveation_dynamic=true
openxr/extensions/hand_tracking=true
shaders/enabled=true
